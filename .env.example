# Rabby environment variables — NAMES ONLY.
# Never put real values or secrets in this file.
# Copy to .env.local and fill in values locally.
# The service role key is server-only: it must never be exposed to the
# browser, committed to the repository, or pasted into chat.
# (No Supabase project exists yet — these are set up in T-03.)

# Public — safe to expose in the browser (used by the Supabase JS client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used only in API routes / server actions. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Order confirmation email (S-6, Gmail SMTP). Server-only.
# The sender is the dedicated shop Gmail account; the app password
# comes from that Google account (2-Step Verification → App
# passwords). An app password is a secret: it must never be committed,
# pasted in chat, or exposed to the browser. The owner sets both vars
# in Vercel (Settings → Environment Variables, All Environments).
GMAIL_USER=
GMAIL_APP_PASSWORD=
